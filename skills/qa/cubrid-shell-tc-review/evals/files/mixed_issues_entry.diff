diff --git a/cubrid-testcases-private-ex/shell/cbrd_25301_online_backup/cases/cbrd_25301_online_backup.sh b/cubrid-testcases-private-ex/shell/cbrd_25301_online_backup/cases/cbrd_25301_online_backup.sh
